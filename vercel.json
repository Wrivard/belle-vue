{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "PORT=25729 BASE_PATH=/ pnpm --filter @workspace/sergerie-website run build",
  "outputDirectory": "artifacts/sergerie-website/dist/public",
  "functions": { "api/quote.ts": { "maxDuration": 30 } },
  "routes": [
    { "src": "/api/quote", "dest": "/api/quote" },
    { "src": "/soumission/?", "dest": "/soumission/index.html" },
    { "src": "/politique-cookies/?", "dest": "/politique-cookies/index.html" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/404.html", "status": 404 }
  ]
}
