{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "node scripts/build-vercel-function.mjs && PORT=25729 BASE_PATH=/ pnpm --filter @workspace/belle-vue-website run build",
  "outputDirectory": "artifacts/belle-vue-website/dist/public",
  "functions": { "api/quote.js": { "maxDuration": 30 } },
  "routes": [
    { "src": "/api/quote", "dest": "/api/quote" },
    { "src": "/soumission/?", "dest": "/soumission/index.html" },
    { "src": "/politique-cookies/?", "dest": "/politique-cookies/index.html" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/404.html", "status": 404 }
  ]
}
